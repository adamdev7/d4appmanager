[Unit]
Description=App Manager API
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/appmanager/backend
Environment=PATH=/var/www/appmanager/backend/.venv/bin
ExecStart=/var/www/appmanager/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
