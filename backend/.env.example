# App
DEBUG=true
# Production public host (Shopify OAuth + webhooks use this by default)
APP_URL=https://appmanager.store
FRONTEND_URL=https://appmanager.store
SHOPIFY_PUBLIC_URL=https://appmanager.store
# Only for local Shopify testing with ngrok — also whitelist that tunnel in Partners
SHOPIFY_ALLOW_DEV_TUNNEL=false

# Database (SQLite default; use PostgreSQL in production)
DATABASE_URL=sqlite:///./data/app_manager.db

# Security — generate with: py -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-random-hex
# Optional dedicated Fernet key (else derived from JWT secret in dev)
ENCRYPTION_KEY=

# Email verification (SMTP) — required for real signup emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_USE_TLS=true

# Shopify Partner app — https://partners.shopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SCOPES=read_products,read_orders,read_customers,read_fulfillments,write_fulfillments,write_orders,read_shopify_payments_payouts

# Google Cloud OAuth — Gmail API + Google sign-in
# Enable Gmail API for inbox/send. Add BOTH redirect URIs in the OAuth client:
#   {APP_URL}/api/v1/gmail/oauth/callback   (connect Gmail in Settings)
#   {APP_URL}/api/v1/auth/google/callback   (sign up / sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI — optional dev fallback if users have not saved their own key in the app
# Each user stores their key encrypted in the database via AI Email Assistant settings.
# Never put real secrets here. All OpenAI calls happen server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2

# AI Ads Creative Intelligence Engine (server-side). Falls back to OPENAI_MODEL / OPENAI_IMAGE_MODEL.
AI_STRATEGY_MODEL=gpt-6-astra
AI_ANALYSIS_MODEL=gpt-6-astra
AI_CREATIVE_MODEL=gpt-6-astra
AI_IMAGE_MODEL=gpt-image-2
AI_AD_GENERATION_ENABLED=false
AI_AD_GENERATION_DAY=monday
AI_AD_IMAGE_COUNT=10
AI_AD_VIDEO_COUNT=10
AI_AD_AUTO_PUBLISH=false

# Order tracking page (optional carrier enrichment)
TRACK17_API_KEY=
YUNEXPRESS_API_KEY=
YUNEXPRESS_API_URL=https://api.yunexpress.com
